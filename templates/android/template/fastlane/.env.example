# Google Play Console service-account JSON. Keep the real file untracked.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=play-store-service-account.json

# Release signing is read from these values or local.properties.
BIUCING_RELEASE_STORE_FILE=signing/release.keystore
BIUCING_RELEASE_STORE_PASSWORD=change-me
BIUCING_RELEASE_KEY_ALIAS=release
BIUCING_RELEASE_KEY_PASSWORD=change-me

# Internal testing is published immediately to the selected test track.
PLAY_STORE_BETA_TRACK=internal
PLAY_STORE_BETA_RELEASE_STATUS=completed

# Production delivery is intentionally a draft until Play Console review is complete.
PLAY_STORE_RELEASE_TRACK=production
PLAY_STORE_RELEASE_STATUS=draft

# Set any of these to false after fastlane/metadata/android is populated.
PLAY_STORE_SKIP_METADATA=true
PLAY_STORE_SKIP_CHANGELOGS=true
PLAY_STORE_SKIP_IMAGES=true
PLAY_STORE_SKIP_SCREENSHOTS=true
