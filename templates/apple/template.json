{
  "name": "apple",
  "description": "Swift + Tuist Apple app starter for mid-sized teams",
  "category": "native",
  "stack": ["Swift", "Tuist", "SwiftPM", "fastlane"],
  "tags": ["apple", "swiftui", "tuist", "fastlane"],
  "platforms": ["ios", "macos", "watchos", "tvos"],
  "maturity": {
    "level": "validated",
    "summary": "Multi-platform Apple starter with doctor, generate, lint, test, beta, and release workflows."
  },
  "validation": {
    "status": "generated-project-verified",
    "verification_tier": "generated-project",
    "evidence": [
      "python unittest template rendering coverage",
      "real generated project make generate/build/test validation"
    ]
  },
  "operating_assumptions": [
    "The starter assumes a native Apple workstation with Xcode-oriented tooling and simulator-first validation.",
    "Generated projects should keep bootstrap, doctor, generate, lint, test, beta, and release workflows explicit."
  ],
  "workflow_labels": ["bootstrap", "doctor", "generate", "lint", "test", "build", "release", "open"],
  "commands": {
    "bootstrap": "make bootstrap",
    "doctor": "make doctor",
    "lint": "make lint",
    "test": "make test",
    "verify": "make verify",
    "build": "make build",
    "clean": "make clean",
    "help": "make help"
  },
  "worktree": {
    "support_level": "worktree-ready",
    "isolation_dimensions": [
      "caches",
      "generated-output",
      "local-config",
      "installed-app-identity",
      "cleanup",
      "diagnostics"
    ],
    "diagnostics": [
      "make worktree-info",
      "make worktree-doctor"
    ],
    "cleanup": [
      "make clean-worktree"
    ]
  },
  "variables": [
    {
      "name": "project_name",
      "required": true,
      "validator": "project-name"
    },
    {
      "name": "display_name",
      "required": false,
      "default_from": "project_name",
      "validator": "display-name"
    },
    {
      "name": "apple_platform",
      "required": false,
      "default": "ios",
      "validator": "choice",
      "choices": ["ios", "macos", "watchos", "tvos"]
    },
    {
      "name": "apple_platform_name",
      "required": false,
      "default": "iOS",
      "validator": "choice",
      "choices": ["iOS", "macOS", "watchOS", "tvOS"]
    },
    {
      "name": "bundle_identifier",
      "required": true,
      "prompt": "Bundle identifier: ",
      "validator": "bundle-identifier"
    },
    {
      "name": "organization_name",
      "required": false,
      "default": "Example Team",
      "validator": "display-name"
    },
    {
      "name": "development_team",
      "required": false,
      "default": "DEVELOPMENT_TEAM_ID",
      "validator": "team-id"
    },
    {
      "name": "minimum_os_version",
      "required": false,
      "default": "26.0",
      "validator": "apple-version"
    },
    {
      "name": "swift_module_name",
      "required": false,
      "validator": "identifier"
    }
  ],
  "next_steps": [
    "make bootstrap",
    "make doctor",
    "make generate",
    "make lint",
    "make test",
    "open {{PROJECT_NAME}}.xcworkspace"
  ]
}
