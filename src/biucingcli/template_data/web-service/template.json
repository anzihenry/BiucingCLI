{
  "name": "web-service",
  "description": "Go + Gin web service starter",
  "category": "backend",
  "stack": [
    "Go",
    "Gin"
  ],
  "tags": [
    "api",
    "docker",
    "go",
    "service"
  ],
  "platforms": [
    "linux",
    "container"
  ],
  "maturity": {
    "level": "validated",
    "summary": "Docker backend with identity, telemetry, verified single-host delivery and Kubernetes reference manifests; multi-zone HA requires target-platform drills."
  },
  "validation": {
    "status": "real-build-verified",
    "verification_tier": "real-build",
    "evidence": [
      "python unittest template rendering coverage",
      "generated-project graceful shutdown and timeout tests",
      "runtime image HTTP health check",
      "real docker runtime image builds",
      "real docker development image builds",
      "P3 independent OIDC/mTLS call-chain and telemetry fault verification (docs/initiatives/feature/backend-services/p3-validation.md)",
      "P4 Linux arm64 Docker Compose signed-image deployment and recovery evidence (docs/initiatives/feature/backend-services/p4-validation.md)",
      "P5 Kustomize/schema and release failure guards; real cluster/HA remains not-run (docs/initiatives/feature/backend-services/p5-validation.md)"
    ]
  },
  "operating_assumptions": [
    "The starter is optimized for Go service development with Docker-based dev and runtime flows.",
    "Generated projects are expected to keep config, build, and verification workflows repo-local.",
    "Database and cache are independent. Production Compose consumes platform-provisioned dependencies, credentials and certificates; single-host updates have interruption windows and do not provide HA.",
    "P5 Kustomize and release tools require platform-provisioned Kubernetes/CNI/Ingress/PKI/managed PostgreSQL. Local manifest verification is separate from real HA acceptance."
  ],
  "workflow_labels": [
    "bootstrap",
    "dev",
    "verify",
    "build",
    "runtime"
  ],
  "commands": {
    "bootstrap": "make bootstrap",
    "doctor": "make doctor",
    "lint": "make lint",
    "test": "make test",
    "verify": "make verify",
    "build": "make build",
    "clean": "make clean",
    "help": "make help"
  },
  "worktree": {
    "support_level": "worktree-ready",
    "isolation_dimensions": [
      "runtime-names",
      "ports",
      "caches",
      "generated-output",
      "cleanup",
      "diagnostics"
    ],
    "diagnostics": [
      "make worktree-info",
      "make worktree-doctor"
    ],
    "cleanup": [
      "make clean-worktree"
    ]
  },
  "variables": [
    {
      "name": "project_name",
      "required": true,
      "validator": "project-name"
    },
    {
      "name": "module_name",
      "required": true,
      "prompt": "Go module name: ",
      "validator": "go-module"
    },
    {
      "name": "service_name",
      "required": false,
      "default_from": "project_name",
      "validator": "slug"
    },
    {
      "name": "http_port",
      "required": false,
      "default": "8080",
      "validator": "port"
    },
    {
      "name": "database",
      "required": false,
      "default": "postgres",
      "validator": "choice",
      "choices": [
        "postgres"
      ]
    },
    {
      "name": "cache",
      "required": false,
      "default": "none",
      "validator": "choice",
      "choices": [
        "none",
        "redis"
      ]
    }
  ],
  "next_steps": [
    "./scripts/task bootstrap",
    "./scripts/task dev",
    "./scripts/task verify",
    "./scripts/task image"
  ],
  "contracts": [
    "docker-compose",
    "go-backend"
  ],
  "required_entries": [
    "internal/runtime/server.go",
    "internal/runtime/server_test.go",
    "scripts/verify-container",
    ".github/workflows/verify.yml",
    "compose.yaml",
    "scripts/task",
    "scripts/check",
    "scripts/init-workspace",
    "internal/app/app.go",
    "internal/runtime/admin.go",
    "internal/pipeline/http.go",
    "internal/security/principal.go",
    "internal/observability/log.go",
    "internal/database/database.go",
    "internal/migration/migration.go",
    "cmd/migrate/main.go",
    "migrations/sql/000001_runtime.up.sql",
    "deploy/postgres-init.sql",
    "api/openapi.json",
    "api/baseline/openapi.json",
    "internal/auth/auth.go",
    "deploy/dex.yaml",
    "scripts/contract",
    "internal/outbound/client.go",
    "internal/outbound/budget.go",
    "internal/outbound/client_test.go",
    "internal/telemetry/telemetry.go",
    "internal/telemetry/telemetry_test.go",
    "internal/database/telemetry.go",
    "deploy/otel-collector.yaml",
    "deploy/alerts.example.yaml",
    "compose.prod.yaml",
    "deploy/RUNBOOK.md",
    "deploy/config.prod.yaml",
    "deploy/release.env.example",
    "deploy/backup-service.conf.example",
    "scripts/release",
    "scripts/security",
    "scripts/database-backup",
    ".github/workflows/release.yml",
    "deploy/kubernetes/base/kustomization.yaml",
    "deploy/kubernetes/base/deployment.yaml",
    "deploy/kubernetes/base/service.yaml",
    "deploy/kubernetes/base/pdb.yaml",
    "deploy/kubernetes/platform/networkpolicy.yaml",
    "deploy/kubernetes/migration/job.yaml",
    "deploy/kubernetes/overlays/production/app/kustomization.yaml",
    "deploy/kubernetes/overlays/autoscaling/app/kustomization.yaml",
    "deploy/kubernetes/README.md",
    "deploy/kubernetes/DRILLS.md",
    "deploy/kubernetes/drill-report.json",
    "deploy/kubernetes/capacity.env",
    "scripts/kube-release",
    "scripts/kube-capacity",
    "scripts/kube-evidence",
    "scripts/verify-kubernetes",
    ".github/workflows/kubernetes.yml"
  ],
  "rule": "backend",
  "derived_outputs": [
    "database_dsn",
    "cache_dsn"
  ],
  "render_outputs": [
    "component_environment",
    "component_services",
    "component_dependencies"
  ]
}
