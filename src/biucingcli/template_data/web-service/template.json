{
  "name": "web-service",
  "description": "Go + Gin web service starter",
  "category": "backend",
  "stack": ["Go", "Gin"],
  "tags": ["api", "docker", "go", "service"],
  "platforms": ["linux", "container"],
  "maturity": {
    "level": "validated",
    "summary": "Dockerized web service starter with bounded HTTP timeouts, graceful shutdown, runtime health checks, lint, and tests."
  },
  "validation": {
    "status": "real-build-verified",
    "verification_tier": "real-build",
    "evidence": [
      "python unittest template rendering coverage",
      "generated-project graceful shutdown and timeout tests",
      "runtime image HTTP health check",
      "real docker runtime image builds",
      "real docker development image builds"
    ]
  },
  "operating_assumptions": [
    "The starter is optimized for Go service development with Docker-based dev and runtime flows.",
    "Generated projects are expected to keep config, build, and verification workflows repo-local."
  ],
  "workflow_labels": ["bootstrap", "dev", "verify", "build", "runtime"],
  "commands": {
    "bootstrap": "make bootstrap",
    "doctor": "make doctor",
    "lint": "make lint",
    "test": "make test",
    "verify": "make verify",
    "build": "make build",
    "clean": "make clean",
    "help": "make help"
  },
  "worktree": {
    "support_level": "worktree-ready",
    "isolation_dimensions": [
      "runtime-names",
      "ports",
      "caches",
      "generated-output",
      "cleanup",
      "diagnostics"
    ],
    "diagnostics": [
      "make worktree-info",
      "make worktree-doctor"
    ],
    "cleanup": [
      "make clean-worktree"
    ]
  },
  "variables": [
    {
      "name": "project_name",
      "required": true,
      "validator": "project-name"
    },
    {
      "name": "module_name",
      "required": true,
      "prompt": "Go module name: ",
      "validator": "go-module"
    },
    {
      "name": "service_name",
      "required": false,
      "default_from": "project_name",
      "validator": "slug"
    },
    {
      "name": "http_port",
      "required": false,
      "default": "8080",
      "validator": "port"
    }
  ],
  "next_steps": [
    "make bootstrap",
    "make dev",
    "make verify",
    "make docker-build",
    "make docker-run"
  ]
}
