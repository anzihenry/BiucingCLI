#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
# Never inherit a user's project or Compose file for verification cleanup.
export COMPOSE_PROJECT_NAME="verify-$(date +%s)-$$"
unset COMPOSE_FILE COMPOSE_PROFILES
compose=(docker compose --project-name "$COMPOSE_PROJECT_NAME" -f compose.dev.yaml)
cleanup() { "${compose[@]}" down --remove-orphans --volumes >/dev/null; }
trap cleanup EXIT
"${compose[@]}" config --quiet
./scripts/task bootstrap
./scripts/task verify
./scripts/task integration
