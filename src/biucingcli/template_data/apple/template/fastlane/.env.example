DEVELOPMENT_TEAM_ID={{DEVELOPMENT_TEAM}}
FASTLANE_USER=developer@example.com

# JSON format supported by fastlane api_key_path. Store it in the ignored credentials directory.
APP_STORE_CONNECT_API_KEY_PATH=credentials/app-store-connect-api-key.json

# Private git repository used by fastlane match for certificates and profiles.
MATCH_GIT_URL=git@github.com:your-org/apple-certificates.git
MATCH_GIT_BRANCH=main
MATCH_TYPE=appstore

# Keep release machines read-only by default. Set true only during first-time certificate/profile setup.
MATCH_ALLOW_WRITE=false

# Optional delivery controls.
TESTFLIGHT_SKIP_WAITING=true
TESTFLIGHT_CHANGELOG=
APP_STORE_SKIP_METADATA=true
APP_STORE_SKIP_SCREENSHOTS=true
APP_STORE_SUBMIT_FOR_REVIEW=false
