{
  "name": "apple",
  "description": "Four Apple shells with versioned static component SDKs and a portable C++20 core",
  "category": "native",
  "stack": [
    "Swift 6.4",
    "C++20",
    "CMake",
    "Tuist",
    "SwiftPM",
    "fastlane",
    "SafeDI 2.0.0"
  ],
  "tags": [
    "apple",
    "cpp",
    "swiftui",
    "tuist",
    "fastlane"
  ],
  "platforms": [
    "ios",
    "macos",
    "watchos",
    "tvos"
  ],
  "maturity": {
    "level": "validated",
    "summary": "Four Apple shells, static XCFramework SDKs, compile-time DI, and portable C++20 core."
  },
  "validation": {
    "status": "generated-project-verified",
    "verification_tier": "generated-project",
    "evidence": [
      "python unittest template rendering coverage",
      "real generated project make generate/build/test validation"
    ]
  },
  "operating_assumptions": [
    "The starter assumes a native Apple workstation with Xcode-oriented tooling and simulator-first validation.",
    "Generated projects should keep bootstrap, doctor, generate, lint, test, beta, and release workflows explicit."
  ],
  "workflow_labels": [
    "bootstrap",
    "doctor",
    "generate",
    "lint",
    "test",
    "build",
    "release",
    "open"
  ],
  "commands": {
    "bootstrap": "make bootstrap",
    "doctor": "make doctor",
    "lint": "make lint",
    "test": "make test",
    "verify": "make verify",
    "build": "make build",
    "clean": "make clean",
    "help": "make help"
  },
  "worktree": {
    "support_level": "worktree-ready",
    "isolation_dimensions": [
      "caches",
      "generated-output",
      "local-config",
      "installed-app-identity",
      "cleanup",
      "diagnostics"
    ],
    "diagnostics": [
      "make worktree-info",
      "make worktree-doctor"
    ],
    "cleanup": [
      "make clean-worktree"
    ]
  },
  "variables": [
    {
      "name": "project_name",
      "required": true,
      "validator": "project-name"
    },
    {
      "name": "display_name",
      "required": false,
      "default_from": "project_name",
      "validator": "display-name",
      "contexts": [
        "SWIFT"
      ]
    },
    {
      "name": "apple_platform",
      "required": false,
      "default": "ios",
      "validator": "choice",
      "choices": [
        "ios",
        "macos",
        "watchos",
        "tvos"
      ]
    },
    {
      "name": "bundle_identifier",
      "required": true,
      "prompt": "Bundle identifier: ",
      "validator": "bundle-identifier"
    },
    {
      "name": "organization_name",
      "required": false,
      "default": "Example Team",
      "validator": "display-name",
      "contexts": [
        "SWIFT"
      ]
    },
    {
      "name": "development_team",
      "required": false,
      "default": "DEVELOPMENT_TEAM_ID",
      "validator": "team-id"
    },
    {
      "name": "minimum_os_version",
      "required": false,
      "default": "26.0",
      "validator": "apple-version"
    },
    {
      "name": "swift_module_name",
      "required": false,
      "validator": "identifier"
    }
  ],
  "next_steps": [
    "make bootstrap",
    "make doctor",
    "make generate",
    "make lint",
    "make test",
    "open {{PROJECT_NAME}}.xcworkspace"
  ],
  "contracts": [
    "native-tools"
  ],
  "required_entries": [
    "Tuist.swift",
    "Workspace.swift",
    "Shared/Core/Package.swift",
    "Shared/Core/CMakeLists.txt",
    "Shared/Core/Sources/CoreNative/include/CoreNative.h",
    "fastlane/Fastfile",
    "scripts/verify-release-identity",
    "Apps/ios/Project.swift",
    "Apps/macos/Project.swift",
    "Apps/watchos/Project.swift",
    "Apps/tvos/Project.swift",
    "Components/Package.swift",
    "Dependencies/components.json",
    "scripts/components"
  ],
  "rule": "apple",
  "derived_outputs": [
    "apple_platform",
    "apple_platform_name",
    "fastlane_platform",
    "app_store_platform",
    "minimum_os_version",
    "tuist_destinations",
    "tuist_deployment_targets",
    "xcodebuild_destination",
    "swiftpm_supported_platform",
    "swift_module_name"
  ],
  "render_outputs": [
    "apple_scene_body",
    "apple_home_body",
    "apple_platform_output_note"
  ]
}
