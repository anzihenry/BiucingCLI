#!/usr/bin/env python3
"""Validate bounded constructor graphs; ArkTS checks generated calls against real APIs."""
import argparse
import copy
import json
from pathlib import Path
import re

ROOT = Path(__file__).resolve().parents[1]
GRAPHS = ['composition/di.json', 'components/homefeature/di.json']


def generate(graph):
    inputs = graph['inputs']
    nodes = {node['id']: node for node in graph['nodes']}
    if len(nodes) != len(graph['nodes']) or set(nodes) & set(inputs):
        raise ValueError('Duplicate binding')
    for name in [graph['function'], *inputs, *nodes]:
        if not re.fullmatch(r'[A-Za-z_][A-Za-z0-9_]*', name):
            raise ValueError('Invalid identifier')
    ordered, visiting, done = [], set(), set(inputs)

    def visit(name):
        if name in visiting:
            raise ValueError('Dependency cycle: ' + name)
        if name in done:
            return
        if name not in nodes:
            raise ValueError('Missing dependency: ' + name)
        visiting.add(name)
        node = nodes[name]
        for dependency in node['args']:
            visit(dependency)
        if set(node.get('methodArgs', {})) - set(node['args']):
            raise ValueError('Unknown method dependency')
        ordered.append(node)
        visiting.remove(name)
        done.add(name)

    for name in nodes:
        visit(name)
    result = graph['result']
    if result not in nodes:
        raise ValueError('Missing result binding')
    lines = ['// Generated by scripts/di; do not edit.']
    for module, symbols in graph['imports'].items():
        lines.append('import { ' + ', '.join(symbols) + " } from '" + module + "';")
    args = ', '.join(name + ': ' + kind for name, kind in inputs.items())
    lines.append('export function ' + graph['function'] + '(' + args + '): ' + nodes[result]['type'] + ' {')
    for node in ordered:
        arguments = [arg + ('.' + node['methodArgs'][arg] + '()' if arg in node.get('methodArgs', {}) else '') for arg in node['args']]
        lines.append('  const ' + node['id'] + ' = new ' + node['type'] + '(' + ', '.join(arguments) + ');')
    lines.extend(['  return ' + result + ';', '}'])
    return '\n'.join(lines) + '\n'


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--scope', choices=['all', 'shell', 'components'], default='all')
    parser.add_argument('--test', action='store_true')
    parser.add_argument('--graph', help='One component-owned graph relative to the product root')
    args = parser.parse_args()
    graphs = GRAPHS[:1] if args.scope == 'shell' else GRAPHS[1:] if args.scope == 'components' else GRAPHS
    if args.graph:
        graphs = [args.graph]
    for relative in graphs:
        source = ROOT / relative
        source.resolve().relative_to(ROOT)
        graph = json.loads(source.read_text())
        text = generate(graph)
        if args.test:
            for mode, expected in [('missing', 'Missing dependency'), ('cycle', 'Dependency cycle')]:
                broken = copy.deepcopy(graph)
                broken['nodes'][0]['args'] = ['absent' if mode == 'missing' else broken['nodes'][0]['id']]
                try:
                    generate(broken)
                except ValueError as error:
                    if expected not in str(error):
                        raise
                else:
                    raise ValueError('DI negative test unexpectedly passed')
        else:
            output = (source.parent / graph['output']).resolve()
            output.relative_to(ROOT)
            output.parent.mkdir(parents=True, exist_ok=True)
            if not output.exists() or output.read_text() != text:
                output.write_text(text)
    print('DI graphs checked' + (' including missing/cyclic bindings' if args.test else ' and generated'))


if __name__ == '__main__':
    main()
