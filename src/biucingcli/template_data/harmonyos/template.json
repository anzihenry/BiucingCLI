{
  "name": "harmonyos",
  "description": "ArkTS HarmonyOS app starter for DevEco Studio projects",
  "category": "native",
  "stack": [
    "ArkTS",
    "ArkUI",
    "HarmonyOS",
    "DevEco Studio",
    "hvigor",
    "ohpm"
  ],
  "tags": [
    "harmonyos",
    "arkts",
    "arkui",
    "deveco",
    "native"
  ],
  "platforms": [
    "harmonyos"
  ],
  "maturity": {
    "level": "experimental",
    "summary": "Thin ArkTS shell consuming independently versioned bytecode HARs, shared C++20/Node-API sessions, build-time DI graphs, exact artifact locks and five-device architecture scope; device runtime acceptance remains required."
  },
  "validation": {
    "status": "generated-project-verified",
    "verification_tier": "generated-project",
    "evidence": [
      "python unittest template rendering coverage",
      "repo-level template metadata and placeholder validation",
      "generated-project bootstrap, lint, test, build, artifact, and release-preflight commands",
      "real bytecode HAR and unsigned HAP builds with pinned DevEco SDK",
      "host Node-API and ArkTS wrapper/model behavior; published-component Hypium tests",
      "source-free Debug/Release consumption and binary closure rejection tests"
    ]
  },
  "operating_assumptions": [
    "The starter assumes DevEco Studio or a local HarmonyOS SDK provides ohpm and hvigor.",
    "Generated projects are structured for an ArkTS Stage model app with one entry module.",
    "Run make components-bootstrap before make bootstrap on a newly generated producer project.",
    "The reviewed SDK supports arm64-v8a and x86_64; device declarations are not runtime certification."
  ],
  "workflow_labels": [
    "bootstrap",
    "doctor",
    "lint",
    "test",
    "build",
    "verify",
    "release",
    "open"
  ],
  "commands": {
    "bootstrap": "make bootstrap",
    "doctor": "make doctor",
    "lint": "make lint",
    "test": "make test",
    "verify": "make verify",
    "build": "make build",
    "clean": "make clean",
    "help": "make help"
  },
  "worktree": {
    "support_level": "worktree-ready",
    "isolation_dimensions": [
      "caches",
      "generated-output",
      "local-config",
      "installed-app-identity",
      "cleanup",
      "diagnostics"
    ],
    "diagnostics": [
      "make worktree-info",
      "make worktree-doctor"
    ],
    "cleanup": [
      "make clean-worktree"
    ]
  },
  "variables": [
    {
      "name": "project_name",
      "required": true,
      "validator": "project-name"
    },
    {
      "name": "display_name",
      "required": false,
      "default_from": "project_name",
      "validator": "display-name",
      "contexts": [
        "JSON",
        "JS_SINGLE"
      ]
    },
    {
      "name": "bundle_name",
      "required": true,
      "prompt": "HarmonyOS bundle name: ",
      "validator": "java-package"
    },
    {
      "name": "harmony_module_name",
      "required": false,
      "default": "entry",
      "validator": "identifier"
    },
    {
      "name": "ability_name",
      "required": false,
      "default": "EntryAbility",
      "validator": "identifier"
    },
    {
      "name": "compatible_sdk_version",
      "required": false,
      "default": "5.0.0(12)",
      "validator": "harmony-sdk-version"
    },
    {
      "name": "target_sdk_version",
      "required": false,
      "default": "5.0.0(12)",
      "validator": "harmony-sdk-version"
    },
    {
      "name": "min_api_version",
      "required": false,
      "default": "12",
      "validator": "positive-integer",
      "maximum": 100
    },
    {
      "name": "harmony_version_code",
      "required": false,
      "default": "1",
      "validator": "positive-integer",
      "maximum": 2100000000
    },
    {
      "name": "harmony_version_name",
      "required": false,
      "default": "1.0.0",
      "validator": "semantic-version"
    },
    {
      "name": "organization_name",
      "required": false,
      "default": "Example Team",
      "validator": "display-name",
      "contexts": [
        "JSON"
      ]
    }
  ],
  "next_steps": [
    "make components-bootstrap",
    "make bootstrap",
    "make doctor",
    "make lint",
    "make test",
    "make build",
    "make artifact-info",
    "make verify",
    "make release-preflight",
    "open -a \"DevEco Studio\" ."
  ],
  "contracts": [
    "native-tools"
  ],
  "required_entries": [],
  "rule": null,
  "derived_outputs": [],
  "render_outputs": []
}
