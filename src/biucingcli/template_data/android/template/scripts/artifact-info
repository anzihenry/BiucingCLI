#!/usr/bin/env bash
set -euo pipefail

case "${PLATFORM:-mobile}" in
  mobile) app_module=app ;;
  wear) app_module=wear ;;
  tv) app_module=tv ;;
  *) echo "PLATFORM must be mobile, wear, or tv" >&2; exit 1 ;;
esac

artifact_path="${app_module}/build/outputs/bundle/release/${app_module}-release.aab"

echo "Android App Bundle artifact check"
./scripts/verify-release-artifact "$artifact_path"

echo "AAB: $artifact_path"
shasum -a 256 "$artifact_path"
du -h "$artifact_path"
