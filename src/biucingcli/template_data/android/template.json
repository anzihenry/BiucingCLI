{
  "name": "android",
  "description": "Kotlin Android app starter for mid-sized teams",
  "category": "native",
  "stack": ["Kotlin", "Android", "Gradle", "Jetpack Compose", "fastlane"],
  "tags": ["android", "kotlin", "compose", "fastlane"],
  "platforms": ["android"],
  "maturity": {
    "level": "validated",
    "summary": "Android starter with doctor, format, build, test, and UI smoke workflows."
  },
  "validation": {
    "status": "generated-project-verified",
    "verification_tier": "generated-project",
    "evidence": [
      "python unittest template rendering coverage",
      "real generated project gradle build validation"
    ]
  },
  "operating_assumptions": [
    "The starter assumes a native Android workstation flow with Gradle, emulator, and release-signing guidance.",
    "Generated projects should expose bootstrap, doctor, format, build, test, and UI smoke workflows."
  ],
  "workflow_labels": ["bootstrap", "doctor", "format", "build", "test", "ui-test", "open"],
  "commands": {
    "bootstrap": "make bootstrap",
    "doctor": "make doctor",
    "lint": "make lint",
    "test": "make test",
    "verify": "make verify",
    "build": "make build",
    "clean": "make clean",
    "help": "make help"
  },
  "worktree": {
    "support_level": "worktree-ready",
    "isolation_dimensions": [
      "caches",
      "generated-output",
      "local-config",
      "installed-app-identity",
      "cleanup",
      "diagnostics"
    ],
    "diagnostics": [
      "make worktree-info",
      "make worktree-doctor"
    ],
    "cleanup": [
      "make clean-worktree"
    ]
  },
  "variables": [
    {
      "name": "project_name",
      "required": true,
      "validator": "project-name"
    },
    {
      "name": "display_name",
      "required": false,
      "default_from": "project_name",
      "validator": "display-name"
    },
    {
      "name": "package_name",
      "required": true,
      "prompt": "Android package name: ",
      "validator": "java-package"
    },
    {
      "name": "application_id",
      "required": false,
      "default_from": "package_name",
      "validator": "java-package"
    },
    {
      "name": "organization_name",
      "required": false,
      "default": "Example Team",
      "validator": "display-name"
    },
    {
      "name": "compile_sdk",
      "required": false,
      "default": "35",
      "validator": "positive-integer",
      "maximum": 100
    },
    {
      "name": "min_sdk",
      "required": false,
      "default": "26",
      "validator": "positive-integer",
      "maximum": 100
    },
    {
      "name": "target_sdk",
      "required": false,
      "default": "35",
      "validator": "positive-integer",
      "maximum": 100
    },
    {
      "name": "version_code",
      "required": false,
      "default": "1",
      "validator": "positive-integer",
      "maximum": 2100000000
    },
    {
      "name": "version_name",
      "required": false,
      "default": "1.0.0",
      "validator": "semantic-version"
    },
    {
      "name": "java_version",
      "required": false,
      "default": "17",
      "validator": "positive-integer",
      "minimum": 8,
      "maximum": 30
    },
    {
      "name": "android_namespace",
      "required": false,
      "default_from": "package_name",
      "validator": "java-package"
    },
    {
      "name": "kotlin_module_name",
      "required": false,
      "validator": "identifier"
    }
  ],
  "next_steps": [
    "make bootstrap",
    "make doctor",
    "make format",
    "make build",
    "make test",
    "make test-ui",
    "open -a \"Android Studio\" ."
  ]
}
