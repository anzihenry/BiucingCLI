{
  "name": "frontend",
  "description": "React + TypeScript starter for independent projects",
  "category": "frontend",
  "stack": ["React", "TypeScript"],
  "tags": ["web", "docker", "playwright", "vitest"],
  "platforms": ["web"],
  "maturity": {
    "level": "validated",
    "summary": "Docker-first frontend starter with test and browser-smoke workflows."
  },
  "validation": {
    "status": "real-build-verified",
    "verification_tier": "real-build",
    "evidence": [
      "python unittest template rendering coverage",
      "real docker runtime image builds",
      "real docker development image builds",
      "real Playwright browser checks against the production Nginx image"
    ]
  },
  "operating_assumptions": [
    "Local development is expected to run through Docker-first workflows.",
    "Browser smoke coverage and runtime packaging are part of the starter contract."
  ],
  "workflow_labels": ["bootstrap", "dev", "test", "build", "runtime"],
  "commands": {
    "bootstrap": "make bootstrap",
    "doctor": "make doctor",
    "lint": "make lint",
    "test": "make test",
    "verify": "make verify",
    "build": "make build",
    "clean": "make clean",
    "help": "make help"
  },
  "worktree": {
    "support_level": "worktree-ready",
    "isolation_dimensions": [
      "runtime-names",
      "ports",
      "caches",
      "generated-output",
      "cleanup",
      "diagnostics"
    ],
    "diagnostics": [
      "make worktree-info",
      "make worktree-doctor"
    ],
    "cleanup": [
      "make clean-worktree"
    ]
  },
  "variables": [
    {
      "name": "project_name",
      "required": true,
      "validator": "project-name"
    },
    {
      "name": "display_name",
      "required": false,
      "default_from": "project_name",
      "validator": "display-name"
    },
    {
      "name": "package_name",
      "required": false,
      "default_from": "project_name",
      "validator": "npm-package"
    }
  ],
  "next_steps": [
    "make bootstrap",
    "make dev",
    "make test",
    "make docker-build",
    "make docker-run"
  ]
}
