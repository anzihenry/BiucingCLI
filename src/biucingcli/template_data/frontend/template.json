{
  "name": "frontend",
  "description": "React Router + TypeScript + Tailwind starter for independent projects",
  "category": "frontend",
  "stack": ["React", "React Router", "TypeScript", "Tailwind CSS", "shadcn/ui"],
  "tags": ["web", "docker", "playwright", "vitest"],
  "platforms": ["web"],
  "maturity": {
    "level": "validated",
    "summary": "CSR and SSG presets with shared tooling; SSR is not yet available."
  },
  "validation": {
    "status": "real-build-verified",
    "verification_tier": "real-build",
    "evidence": [
      "Python template generation regression tests",
      "Generated CSR frozen install, strict peers and quality gates on macOS and Docker Linux arm64",
      "Docker development and static Nginx production image builds",
      "Actual Nginx desktop/mobile and static-response Playwright checks using macOS Chrome and Docker Linux arm64 Chromium",
      "CSR Docker Linux arm64 default Headless Shell: three production and two development browser tests passed",
      "SSG macOS and Docker Linux arm64 frozen install, strict quality gates and static production image build",
      "SSG actual Nginx: seven Linux arm64 default Headless Shell tests including delayed hydration, metadata, fixed data and real 404",
      "SSG Linux arm64 cold and repeated development launches: four browser tests each; macOS Chrome development and static preview passed"
    ]
  },
  "operating_assumptions": [
    "Local development is expected to run through Docker-first workflows.",
    "Browser smoke coverage and runtime packaging are part of the starter contract."
  ],
  "workflow_labels": ["bootstrap", "dev", "test", "build", "runtime"],
  "commands": {
    "bootstrap": "make bootstrap",
    "doctor": "make doctor",
    "lint": "make lint",
    "test": "make test",
    "verify": "make verify",
    "build": "make build",
    "clean": "make clean",
    "help": "make help"
  },
  "worktree": {
    "support_level": "worktree-ready",
    "isolation_dimensions": [
      "runtime-names",
      "ports",
      "caches",
      "generated-output",
      "cleanup",
      "diagnostics"
    ],
    "diagnostics": ["make worktree-info", "make worktree-doctor"],
    "cleanup": ["make clean-worktree"]
  },
  "variables": [
    {
      "name": "project_name",
      "required": true,
      "validator": "project-name"
    },
    {
      "name": "display_name",
      "required": false,
      "default_from": "project_name",
      "validator": "display-name",
      "contexts": ["JSON", "XML"]
    },
    {
      "name": "package_name",
      "required": false,
      "default_from": "project_name",
      "validator": "npm-package"
    },
    {
      "name": "rendering",
      "required": true,
      "validator": "text",
      "choices": ["csr", "ssg"],
      "default": "csr"
    }
  ],
  "next_steps": [
    "make bootstrap",
    "make dev",
    "make test",
    "make docker-build",
    "make docker-run"
  ],
  "contracts": ["docker-compose"],
  "required_entries": [
    "pnpm-lock.yaml",
    "playwright.production.config.ts",
    "scripts/browser-smoke-production",
    "tests/production-browser-smoke.spec.ts",
    "pnpm-workspace.yaml",
    "components.json",
    "app/root.tsx",
    "app/app.css",
    "app/components/ui/button.tsx",
    "app/components/ui/dialog.tsx",
    "vitest.config.ts",
    "scripts/check-toolchain.mjs",
    "tests/interactions.ts",
    "THIRD_PARTY_NOTICES.md",
    "vite.preview.config.ts"
  ],
  "rule": null,
  "derived_outputs": [],
  "render_outputs": [],
  "variants": {
    "selector": "rendering",
    "options": {
      "csr": {
        "source": "variants/csr/template",
        "required_entries": [
          "react-router.config.ts",
          "app/routes.ts",
          "app/routes/home.tsx",
          "playwright.build.config.ts",
          "nginx.conf"
        ],
        "forbidden_entries": [
          "src",
          "index.html",
          "app/entry.server.tsx",
          "server"
        ],
        "overrides": []
      },
      "ssg": {
        "source": "variants/ssg/template",
        "next_steps": [
          "make bootstrap",
          "make dev",
          "make test",
          "export SITE_URL=https://example.com",
          "make docker-build",
          "make docker-run"
        ],
        "required_entries": [
          "react-router.config.ts",
          "app/routes.ts",
          "app/routes/home.tsx",
          "app/routes/article.tsx",
          "app/content.ts",
          "app/lib/site.ts",
          "app/lib/content.server.ts",
          "app/routes/sitemap.ts",
          "app/routes/robots.ts",
          "public/404.html",
          "tests/ssg.ts",
          "playwright.build.config.ts",
          "nginx.conf"
        ],
        "forbidden_entries": ["src", "index.html", "app/entry.server.tsx", "server"],
        "overrides": []
      }
    }
  }
}
