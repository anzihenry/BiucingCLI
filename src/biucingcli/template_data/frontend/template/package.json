{
  "name": "{{PACKAGE_NAME}}",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "react-router dev",
    "build": "pnpm typecheck && react-router build",
    "preview": "vite preview",
    "typecheck": "react-router typegen && node ./node_modules/@typescript/native/bin/tsc --noEmit",
    "lint": "react-router typegen && eslint . --max-warnings=0 && node scripts/check-toolchain.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "browser:install": "playwright install chromium",
    "browser:smoke": "playwright test -c playwright.smoke.config.ts",
    "browser:smoke:build": "pnpm build && playwright test -c playwright.build.config.ts",
    "browser:smoke:production": "playwright test -c playwright.production.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@react-router/node": "8.4.0",
    "@react-router/serve": "8.4.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "isbot": "^5",
    "lucide-react": "^1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@react-router/dev": "8.4.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.11.0",
    "jsdom": "30.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/user-event": "14.6.1",
    "playwright": "1.63.0",
    "prettier": "3.6.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-config-prettier": "10.1.8"
  },
  "version": "0.1.0",
  "engines": {
    "node": ">=24.19.0 <25"
  }
}
