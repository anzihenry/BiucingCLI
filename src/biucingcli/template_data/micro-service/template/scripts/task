#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
id="$(printf '%s' "$root" | cksum | awk '{print $1}')"
if [ "${DOCKER_VARIANT:-alpine}" = ubuntu ]; then export BUILDER_IMAGE="${BUILDER_IMAGE:-public.ecr.aws/docker/library/golang:1.26.8}" RUNTIME_IMAGE="${RUNTIME_IMAGE:-public.ecr.aws/docker/library/ubuntu:26.04}"; fi
export COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME:-{{SERVICE_NAME}}-$id}"
export IMAGE="${IMAGE:-$COMPOSE_PROJECT_NAME}"
export LOCAL_UID="$(id -u)"
export LOCAL_GID="$(id -g)"
export TAG="${TAG:-dev}"
export HOST_PORT="${HOST_PORT:-0}"
export HOST_HTTP_PORT="${HOST_HTTP_PORT:-0}"
export HOST_GRPC_PORT="${HOST_GRPC_PORT:-0}"
compose=(docker compose --project-name "$COMPOSE_PROJECT_NAME" -f compose.dev.yaml)
run=("${compose[@]}" run --rm --no-deps app-dev)
case "${1:-help}" in
 bootstrap) ./scripts/local-ca; "${compose[@]}" build app-dev; "${compose[@]}" run --rm --no-deps --user 0 app-dev ./scripts/init-workspace ;;
 dev|up) "${compose[@]}" up -d app-dev otel-collector; "${compose[@]}" port app-dev {{HTTP_PORT}} ;;
 down|clean) "${compose[@]}" down --remove-orphans ;;
 clean-worktree) if [ "${CONFIRM_DELETE_DATA:-}" != yes ]; then echo 'Set CONFIRM_DELETE_DATA=yes to delete this project data and caches.' >&2; exit 2; fi; "${compose[@]}" down --volumes --remove-orphans ;;
 telemetry) "${compose[@]}" --profile observability up -d otel-collector ;;
 logs) "${compose[@]}" logs -f ;;
 doctor) docker info >/dev/null; "${compose[@]}" config --quiet; "${run[@]}" ./scripts/check proto; "${run[@]}" ./scripts/doctor ;;
 verify) "${run[@]}" ./scripts/check ;;
 lint|test|build|proto|tidy) "${run[@]}" ./scripts/check "$1" ;;
 run) "${compose[@]}" run --rm --service-ports app-dev ;;
 dev-shell) "${run[@]}" bash ;;
 image|docker-build) "${run[@]}" ./scripts/check proto
 docker build ${DOCKER_PLATFORM:+--platform=$DOCKER_PLATFORM} --build-arg GOPROXY="${GOPROXY:-https://proxy.golang.org,direct}" --build-arg GOSUMDB="${GOSUMDB:-sum.golang.org}" --build-arg BUILDER_IMAGE="${BUILDER_IMAGE:-golang:1.26.8-alpine}" --build-arg RUNTIME_IMAGE="${RUNTIME_IMAGE:-alpine:3.23.6}" --build-arg VERSION="${VERSION:-dev}" --build-arg COMMIT="${COMMIT:-$(git rev-parse --short HEAD 2>/dev/null || echo unknown)}" --build-arg BUILT_AT="${BUILT_AT:-$(date -u +%FT%TZ)}" -t "$IMAGE:$TAG" . ;;
 docker-run) runtime=(docker compose --project-name "$COMPOSE_PROJECT_NAME-runtime" -f compose.yaml); if [ "{{DATABASE}}" = postgres ]; then "${runtime[@]}" up -d --wait postgres; "${runtime[@]}" run --rm --no-deps -e MIGRATION_DSN="${MIGRATION_DSN:-postgres://{{SERVICE_NAME}}_migrator:local-migrate-only@postgres:5432/{{SERVICE_NAME}}?sslmode=disable}" --entrypoint /app/migrate {{SERVICE_NAME}}; fi; "${runtime[@]}" up -d ;;
 docker-push) docker push "$IMAGE:$TAG" ;;
 migrate) [ "{{DATABASE}}" = postgres ] || { echo 'No database configured' >&2; exit 2; }; "${compose[@]}" up -d --wait postgres; "${compose[@]}" run --rm --no-deps -e MIGRATION_DSN="${MIGRATION_DSN:-postgres://{{SERVICE_NAME}}_migrator:local-migrate-only@postgres:5432/{{SERVICE_NAME}}?sslmode=disable}" app-dev go run ./cmd/migrate ;;
 integration) [ "{{DATABASE}}" = postgres ] || exit 0; ./scripts/task migrate; "${compose[@]}" run --rm --no-deps -e TEST_DATABASE_DSN="postgres://{{SERVICE_NAME}}_app:local-app-only@postgres:5432/{{SERVICE_NAME}}?sslmode=disable" -e TEST_MIGRATION_DSN="postgres://{{SERVICE_NAME}}_migrator:local-migrate-only@postgres:5432/{{SERVICE_NAME}}?sslmode=disable" app-dev go test -race -count=1 ./internal/database ./internal/migration ;;
 worktree-compose-config) "${compose[@]}" config ;;
 worktree-info|worktree-doctor) printf 'Worktree: %s\nCompose project: %s\nImage: %s:%s\n' "$root" "$COMPOSE_PROJECT_NAME" "$IMAGE" "$TAG"; "${compose[@]}" ps ;;
 help) printf '%s\n' 'Commands: bootstrap dev verify integration image migrate up down logs telemetry doctor lint test build proto tidy run dev-shell docker-build docker-run docker-push clean worktree-info worktree-doctor worktree-compose-config clean-worktree' ;;
 *) echo 'Unknown task' >&2;exit 2 ;;
esac
