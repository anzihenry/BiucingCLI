{
  "name": "worker",
  "description": "Go background worker starter with scheduled and oneshot execution modes",
  "category": "backend",
  "stack": ["Go", "Docker"],
  "tags": ["worker", "docker", "go", "async"],
  "platforms": ["linux", "container"],
  "maturity": {
    "level": "validated",
    "summary": "Dockerized worker starter with explicit retry semantics, bounded shutdown, and deterministic generated-project tests."
  },
  "validation": {
    "status": "generated-project-verified",
    "verification_tier": "generated-project",
    "evidence": [
      "python unittest template rendering coverage",
      "deterministic injected-clock retry and scheduling tests",
      "real generated project go test validation"
    ]
  },
  "operating_assumptions": [
    "The starter is optimized for background execution rather than a public HTTP API surface.",
    "Generated projects are expected to keep config, verification, and container packaging repo-local."
  ],
  "workflow_labels": ["bootstrap", "dev", "verify", "build", "runtime"],
  "commands": {
    "bootstrap": "make bootstrap",
    "doctor": "make doctor",
    "lint": "make lint",
    "test": "make test",
    "verify": "make verify",
    "build": "make build",
    "clean": "make clean",
    "help": "make help"
  },
  "worktree": {
    "support_level": "worktree-ready",
    "isolation_dimensions": [
      "runtime-names",
      "caches",
      "generated-output",
      "cleanup",
      "diagnostics"
    ],
    "diagnostics": [
      "make worktree-info",
      "make worktree-doctor"
    ],
    "cleanup": [
      "make clean-worktree"
    ]
  },
  "variables": [
    {
      "name": "project_name",
      "required": true,
      "validator": "project-name"
    },
    {
      "name": "module_name",
      "required": true,
      "prompt": "Go module name: ",
      "validator": "go-module"
    },
    {
      "name": "worker_name",
      "required": false,
      "default_from": "project_name",
      "validator": "slug"
    },
    {
      "name": "run_mode",
      "required": false,
      "default": "scheduled",
      "validator": "choice",
      "choices": ["scheduled", "oneshot"]
    },
    {
      "name": "tick_interval_seconds",
      "required": false,
      "default": "30",
      "validator": "positive-integer",
      "maximum": 86400
    },
    {
      "name": "shutdown_timeout_seconds",
      "required": false,
      "default": "10",
      "validator": "positive-integer",
      "maximum": 3600
    }
  ],
  "next_steps": [
    "make bootstrap",
    "make dev",
    "make verify",
    "make docker-build",
    "make docker-run"
  ]
}
