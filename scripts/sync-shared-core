#!/usr/bin/env python3
"""Materialize the authoritative portable core into distributable template trees."""
import argparse
from pathlib import Path
import shutil

ROOT = Path(__file__).resolve().parents[1]
SOURCES = ROOT / 'shared/core'
DESTINATIONS = [ROOT / 'src/biucingcli/template_data' / platform / 'template' / location
                for platform, location in [('apple', 'Shared/Core'), ('android', 'shared/core'), ('harmonyos', 'shared/core')]]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--check', action='store_true')
args = parser.parse_args()


def managed_files(root):
    files = {Path('CMakeLists.txt')} if (root / 'CMakeLists.txt').is_file() else set()
    for directory in ('Sources/CoreNative', 'Tests/Native'):
        files.update(path.relative_to(root) for path in (root / directory).rglob('*')
                     if path.is_file())
    return files


expected = managed_files(SOURCES)
for destination in DESTINATIONS:
    for relative in sorted(managed_files(destination) - expected):
        output = destination / relative
        if args.check:
            raise SystemExit(f'Unexpected portable core file: {output}; run scripts/sync-shared-core')
        output.unlink()
    for relative in sorted(expected):
        source = SOURCES / relative
        output = destination / relative
        if args.check:
            if not output.is_file() or output.read_bytes() != source.read_bytes():
                raise SystemExit(f'Portable core drift: {output}; run scripts/sync-shared-core')
        else:
            output.parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(source, output)
print('Portable core sources are synchronized.')
