#!/usr/bin/env python3
"""Build and smoke-test BiucingCLI from its installed wheel."""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import tarfile
import tempfile
import zipfile
from pathlib import Path

from config_validation import validate_configurations
from distribution_resources import (
    assert_resources_equal, extract_sdist, sdist_resources, source_resources, wheel_resources,
)


REPOSITORY_ROOT = Path(__file__).resolve().parents[1]
EXPECTED_TEMPLATES = {
    "android",
    "apple",
    "frontend",
    "harmonyos",
    "microservice",
    "web-service",
    "worker",
}
PLACEHOLDER_PATTERN = re.compile(r"\{\{[A-Z0-9_]+\}\}")


def run(*args: str, cwd: Path | None = None, env: dict[str, str] | None = None) -> str:
    """Run one verification command and return stdout."""
    try:
        result = subprocess.run(
            args,
            cwd=cwd,
            env=env,
            check=True,
            capture_output=True,
            text=True,
        )
    except subprocess.CalledProcessError as exc:
        if exc.stdout:
            print(exc.stdout, file=sys.stderr, end="")
        if exc.stderr:
            print(exc.stderr, file=sys.stderr, end="")
        raise
    return result.stdout


def assert_archives_contain_templates(wheel: Path, source_dist: Path) -> None:
    """Assert both distribution formats contain package-owned template resources."""
    with zipfile.ZipFile(wheel) as archive:
        wheel_names = set(archive.namelist())
    with tarfile.open(source_dist) as archive:
        source_names = {member.name for member in archive.getmembers()}

    required_suffixes = {
        "src/biucingcli/template_data/frontend/template.json",
        "src/biucingcli/template_data/frontend/template/.gitignore",
        "src/biucingcli/template_data/frontend/variants/ssg/template/.env.example",
        "src/biucingcli/template_data/frontend/variants/ssg/template/react-router.config.ts",
        "src/biucingcli/template_data/frontend/variants/ssg/template/public/404.html",
        "src/biucingcli/template_data/frontend/variants/ssr/template/.env.example",
        "src/biucingcli/template_data/frontend/variants/ssr/template/server/index.ts",
        "src/biucingcli/template_data/frontend/variants/ssr/template/app/entry.server.tsx",
        "src/biucingcli/template_data/android/template/gradle/wrapper/gradle-wrapper.jar",
    }
    for suffix in required_suffixes:
        wheel_suffix = suffix.removeprefix("src/")
        if not any(name.endswith(wheel_suffix) for name in wheel_names):
            raise AssertionError(f"wheel is missing {wheel_suffix}")
        if not any(name.endswith(suffix) for name in source_names):
            raise AssertionError(f"source distribution is missing {suffix}")


def assert_generated_project(project: Path, check_make: bool = False) -> None:
    """Check common generated-project invariants without installing template toolchains."""
    for relative_path in ("README.md", "Makefile", ".gitignore", "scripts/doctor"):
        if not (project / relative_path).is_file():
            raise AssertionError(f"{project.name} is missing {relative_path}")
    if not os.access(project / "scripts" / "doctor", os.X_OK):
        raise AssertionError(f"{project.name}/scripts/doctor is not executable")

    for path in project.rglob("*"):
        if not path.is_file():
            continue
        try:
            content = path.read_text(encoding="utf-8")
        except UnicodeDecodeError:
            continue
        if PLACEHOLDER_PATTERN.search(content):
            raise AssertionError(f"{project.name} contains an unresolved placeholder in {path}")

    counts = validate_configurations(project)
    if not counts:
        raise AssertionError(f"{project.name} contains no parsed configuration files")
    print(f"{project.name}: parsed {sum(counts.values())} configuration files ({counts})")
    if check_make:
        run("make", "-s", "help", cwd=project)


def main() -> None:
    """Build artifacts, install the wheel, and verify the installed CLI."""
    with tempfile.TemporaryDirectory(prefix="biucing-distribution-") as temporary_directory:
        audit_root = Path(temporary_directory)
        parser = argparse.ArgumentParser(description=__doc__)
        parser.add_argument("--dist-dir", type=Path, help="Verify existing artifacts without rebuilding")
        parser.add_argument("--check-make", action="store_true", help="Also run platform-dependent make help checks")
        args = parser.parse_args()
        dist_dir = args.dist_dir.resolve() if args.dist_dir else audit_root / "dist"
        environment = dict(os.environ)
        environment.pop("PYTHONPATH", None)

        if not args.dist_dir:
            run(
                "uv", "build", "--no-sources", "--no-build-isolation",
                "--python", sys.executable, "--out-dir", str(dist_dir),
                cwd=REPOSITORY_ROOT, env=environment,
            )
        wheels = list(dist_dir.glob("*.whl"))
        source_dists = list(dist_dir.glob("*.tar.gz"))
        if len(wheels) != 1 or len(source_dists) != 1:
            raise AssertionError("expected exactly one wheel and one source distribution")
        wheel, source_dist = wheels[0], source_dists[0]
        run(sys.executable, "-m", "twine", "check", "--strict", str(wheel), str(source_dist))
        assert_archives_contain_templates(wheel, source_dist)
        expected = source_resources(REPOSITORY_ROOT / "src/biucingcli/template_data")
        assert_resources_equal(expected, wheel_resources(wheel), "wheel resources")
        assert_resources_equal(expected, sdist_resources(source_dist), "sdist resources")
        source_root = extract_sdist(source_dist, audit_root / "source")
        rebuilt_dir = audit_root / "rebuilt"
        run("uv", "build", "--wheel", "--no-sources", "--no-build-isolation",
            "--python", sys.executable, "--out-dir", str(rebuilt_dir),
            cwd=source_root, env=environment)
        rebuilt_wheels = list(rebuilt_dir.glob("*.whl"))
        if len(rebuilt_wheels) != 1:
            raise AssertionError("expected exactly one wheel rebuilt from sdist")
        assert_resources_equal(expected, wheel_resources(rebuilt_wheels[0]), "sdist-rebuilt wheel resources")
        print(f"Exact bytes/executable flags verified for {len(expected)} resources in wheel, sdist and rebuilt wheel")

        virtual_environment = audit_root / "venv"
        run("uv", "venv", "--python", sys.executable, str(virtual_environment))
        executable_dir = "Scripts" if os.name == "nt" else "bin"
        python = virtual_environment / executable_dir / ("python.exe" if os.name == "nt" else "python")
        biucing = virtual_environment / executable_dir / "biucing"
        run("uv", "pip", "install", "--python", str(python), "--no-deps", str(wheel), cwd=audit_root)
        os.environ.pop("PYTHONPATH", None)

        run_dir = audit_root / "outside-source-tree"
        run_dir.mkdir()
        list_payload = json.loads(run(str(biucing), "list", "--json", cwd=run_dir))
        template_names = {item["name"] for item in list_payload["templates"]}
        if template_names != EXPECTED_TEMPLATES:
            raise AssertionError(f"installed template set differs: {sorted(template_names)}")
        run(str(biucing), "validate", cwd=run_dir)

        projects_dir = run_dir / "projects"
        projects_dir.mkdir()
        create_commands = {
            "frontend": [],
            "web-service": ["--module-name", "github.com/example/audit-web"],
            "microservice": [
                "--module-name",
                "github.com/example/audit-microservice",
                "--proto-package",
                "audit.v1",
            ],
            "worker": ["--module-name", "github.com/example/audit-worker"],
            "apple": ["--bundle-identifier", "com.example.auditapple"],
            "android": ["--package-name", "com.example.auditandroid"],
            "harmonyos": ["--bundle-name", "com.example.auditharmony"],
        }
        for template_name, options in create_commands.items():
            project_name = f"audit-{template_name}"
            run(
                str(biucing),
                "create",
                template_name,
                project_name,
                "--output-dir",
                str(projects_dir),
                "--non-interactive",
                *options,
                cwd=run_dir,
            )
            assert_generated_project(projects_dir / project_name, check_make=args.check_make)

        run(str(biucing), "create", "frontend", "audit-frontend-ssg", "--set", "rendering=ssg",
            "--output-dir", str(projects_dir), "--non-interactive", cwd=run_dir)
        ssg_project = projects_dir / "audit-frontend-ssg"
        assert_generated_project(ssg_project, check_make=args.check_make)
        for name in ("react-router.config.ts", "app/routes/article.tsx", "public/404.html", ".env.example"):
            if not (ssg_project / name).is_file():
                raise AssertionError(f"installed SSG output is missing {name}")

        run(str(biucing), "create", "frontend", "audit-frontend-ssr", "--set", "rendering=ssr",
            "--output-dir", str(projects_dir), "--non-interactive", cwd=run_dir)
        ssr_project = projects_dir / "audit-frontend-ssr"
        assert_generated_project(ssr_project, check_make=args.check_make)
        for name in ("server/index.ts", "server/runtime.ts", "app/entry.server.tsx", ".env.example"):
            if not (ssr_project / name).is_file():
                raise AssertionError(f"installed SSR output is missing {name}")
        if (ssr_project / "nginx.conf").exists():
            raise AssertionError("installed SSR output contains static runtime config")

        android_wrapper = (
            projects_dir
            / "audit-android"
            / "gradle"
            / "wrapper"
            / "gradle-wrapper.jar"
        )
        if not android_wrapper.is_file():
            raise AssertionError("installed artifact did not generate gradle-wrapper.jar")

    print("Distribution verification passed for wheel, sdist, and all seven templates.")


if __name__ == "__main__":
    main()
